#!/usr/bin/env python3
"""
XAI Telemetry Engine: Ergonomic Feature Processing & Closed-Form Velocity Governor
Formulation:
  F(t) = w1*(PERCLOS/0.8) + w2*(||neck - torso||/Delta) + w3*tanh(integral(tau)/20)
  v_cmd(t) = v_nom(t) * sigma(kappa * (d_min - d_safety)) * (1.0 - lambda * F(t))
"""

import time
import numpy as np
from typing import Dict, Tuple

class XAITelemetryEngine:
    def __init__(
        self,
        d_safety: float = 0.35,
        kappa: float = 8.0,
        lambda_f: float = 0.75,
        a_decel_max: float = 2.50
    ):
        self.d_safety = d_safety
        self.kappa = kappa
        self.lambda_f = lambda_f
        self.a_decel_max = a_decel_max

        self.w1 = 0.45  # PERCLOS weight
        self.w2 = 0.35  # Posture deviation weight
        self.w3 = 0.20  # Handover torque weight

    def compute_fatigue_index(self, perclos: float, posture_dev: float, torque_load: float) -> float:
        term_eye = self.w1 * np.clip(perclos / 0.80, 0.0, 1.0)
        term_posture = self.w2 * np.clip(posture_dev / 0.85, 0.0, 1.0)
        term_torque = self.w3 * np.tanh(torque_load / 20.0)
        return float(np.clip(term_eye + term_posture + term_torque, 0.0, 1.0))

    def compute_velocity_scaling(self, d_min: float, fatigue_index: float) -> Tuple[float, float]:
        spatial_gate = 1.0 / (1.0 + np.exp(-self.kappa * (d_min - self.d_safety)))
        fatigue_gate = 1.0 - (self.lambda_f * fatigue_index)
        scaling_factor = float(np.clip(spatial_gate * fatigue_gate, 0.05, 1.0))
        
        # ISO 15066 Dynamic Stopping Distance: s = v^2 / (2*a) + v * t_reaction
        v_actual = 1.25 * scaling_factor
        stopping_distance_mm = ((v_actual**2) / (2.0 * self.a_decel_max) + v_actual * 0.005) * 1000.0
        return scaling_factor, stopping_distance_mm

    def generate_local_attribution(self, telemetry: np.ndarray) -> Dict[str, float]:
        """
        Closed-form sensitivity attribution approximation: phi_i = (x_i - baseline_i) * d(Scale)/dx_i
        """
        feature_names = [
            "d_min_m", "v_rel_mps", "perclos", "posture_dev_rad",
            "handover_torque_nm", "shift_s", "jerk_mps3", "ambient_lux"
        ]
        baseline = np.array([1.5, 0.1, 0.05, 0.05, 2.0, 0.0, 0.1, 500.0])
        deltas = telemetry - baseline

        # Gradients derived analytically
        attributions = {
            "d_min_m": float(np.clip(deltas[0] * 0.45, -0.60, 0.0)),
            "v_rel_mps": float(np.clip(deltas[1] * -0.15, -0.30, 0.0)),
            "perclos": float(np.clip(deltas[2] * -0.55, -0.45, 0.0)),
            "posture_dev_rad": float(np.clip(deltas[3] * -0.35, -0.35, 0.0)),
            "handover_torque_nm": float(np.clip(deltas[4] * -0.02, -0.25, 0.0)),
            "shift_s": float(np.clip(deltas[5] * -0.00005, -0.15, 0.0)),
            "jerk_mps3": float(np.clip(deltas[6] * -0.02, -0.10, 0.0)),
            "ambient_lux": float(np.clip((deltas[7] / 500.0) * 0.02, -0.05, 0.05))
        }
        return attributions

if __name__ == "__main__":
    engine = XAITelemetryEngine()
    # Test State: d_min=0.32m, v_rel=0.4m/s, perclos=0.55, posture=0.45rad, torque=16Nm
    sample = np.array([0.32, 0.40, 0.55, 0.45, 16.0, 1200.0, 0.8, 480.0])
    
    f_index = engine.compute_fatigue_index(sample[2], sample[3], sample[4])
    scale, stop_dist = engine.compute_velocity_scaling(sample[0], f_index)
    phi = engine.generate_local_attribution(sample)
    
    print(f"Fatigue Index F(t) : {f_index:.4f}")
    print(f"Velocity Scale     : {scale:.4f}")
    print(f"Stopping Distance  : {stop_dist:.2f} mm")
    print(f"Top Attribution    : {min(phi, key=phi.get)} ({min(phi.values()):.4f})")
