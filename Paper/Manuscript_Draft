\section{System Mathematical Formulation}

\subsection{Operator Biomechanical Fatigue Index}
The dynamic fatigue index $F(t) \in [0, 1]$ integrates ocular, postural, and mechanical load:
\begin{equation}
F(t) = w_1 \frac{\text{PERCLOS}(t)}{\text{PERCLOS}_{\max}} + w_2 \frac{\|\mathbf{p}_{\text{neck}}(t) - \mathbf{p}_{\text{torso}}(t)\|_2}{\Delta_{\text{limit}}} + w_3 \tanh\left(\frac{\int_{t-T}^t \|\boldsymbol{\tau}_h(t')\|_2 dt'}{\tau_0}\right)
\label{eq:fatigue}
\end{equation}
where $\sum_{i=1}^3 w_i = 1.0$, with empirical weights $w_1 = 0.45$, $w_2 = 0.35$, and $w_3 = 0.20$.

\subsection{Closed-Form Velocity Scaling Governor}
The command velocity vector $\mathbf{v}_{\text{cmd}}(t)$ scales nominal end-effector velocity $\mathbf{v}_{\text{nom}}(t)$ via a logistic spatial clearance gate coupled with fatigue attenuation:
\begin{equation}
\mathbf{v}_{\text{cmd}}(t) = \mathbf{v}_{\text{nom}}(t) \cdot \sigma\left(\kappa \cdot \left(d_{\min}(t) - d_{\text{safety}}\right)\right) \cdot \left(1.0 - \lambda F(t)\right)
\label{eq:scaling}
\end{equation}
where $\sigma(z) = \frac{1}{1 + e^{-z}}$, $\kappa = 8.0$, $d_{\text{safety}} = 0.35$\,m, and $\lambda = 0.75$.

\subsection{Additive Feature Attribution via Kernel SHAP}
Local explainability assigns additive importance values $\phi_i$ to each input feature:
\begin{equation}
\phi_i(f, \mathbf{x}) = \sum_{S \subseteq \mathcal{F} \setminus \{i\}} \frac{|S|!(|\mathcal{F}| - |S| - 1)!}{|\mathcal{F}|!} \left[f_x(S \cup \{i\}) - f_x(S)\right]
\label{eq:shap}
\end{equation}
satisfying local efficiency: $\sum_{i=1}^{M} \phi_i(f, \mathbf{x}) = f(\mathbf{x}) - \mathbb{E}[f(\mathbf{X})]$.

